exports[`Snapshot je Dienst telegram-relay 1`] = `
"<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Erzeugt von tybo aus src/lib/services/catalog.ts; die nächste Einrichtung überschreibt Änderungen -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.tybo.telegram-relay</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/bun/bin/bun</string>
		<string>run</string>
		<string>src/bot.ts</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/home/test/tybo</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/bun/bin:/home/test/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
		<key>HOME</key>
		<string>/home/test</string>
		<key>GO_PROJECT_ROOT</key>
		<string>/home/test/tybo</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/home/test/tybo/logs/telegram-relay.log</string>
	<key>StandardErrorPath</key>
	<string>/home/test/tybo/logs/telegram-relay.error.log</string>
</dict>
</plist>
"
`;

