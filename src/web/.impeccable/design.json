  "components": [
    {
      "name": "Primärknopf",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Einziger farbige Knopf, Login-Anmelden.",
      "html": "<button class=\"ds-btn-primary\">Anmelden</button>",
      "css": ".ds-btn-primary{padding:0.75rem 1rem;border:0;border-radius:0.75rem;background:var(--accent, #1f6fd6);color:var(--accent-ink, #ffffff);font:600 1rem/1.5 var(--sans, system-ui, sans-serif);cursor:pointer}.ds-btn-primary:hover{filter:brightness(1.08)}.ds-btn-primary:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-btn-primary:disabled{opacity:0.6}"
    },
    {
      "name": "Eingabebox mit Senden",
      "kind": "input",
      "refersTo": "composer-box",
      "description": "Runde Eingabebox am Fuß des Chats, Senden rechts.",
      "html": "<div class=\"ds-composer\"><textarea rows=\"1\" placeholder=\"Nachricht an tybo\" aria-label=\"Nachricht\"></textarea><button class=\"ds-send\" aria-label=\"Senden\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg></button></div>",
      "css": ".ds-composer{display:flex;align-items:flex-end;gap:0.5rem;max-width:47.5rem;padding:0.35rem 0.35rem 0.35rem 1rem;border:1px solid var(--line, #e4e6ea);border-radius:1.5rem;background:var(--raised, #ffffff);box-shadow:var(--shadow, 0 2px 10px rgba(20,24,31,0.07))}.ds-composer:focus-within{border-color:color-mix(in srgb, var(--accent, #1f6fd6) 55%, var(--line, #e4e6ea))}.ds-composer textarea{flex:1;min-width:0;padding:0.5rem 0;border:0;outline:none;background:transparent;font:1rem/1.5 system-ui,sans-serif;color:var(--ink, #1a1c20);resize:none}.ds-composer textarea::placeholder{color:var(--placeholder, #6b717b)}.ds-send{display:grid;place-items:center;width:2.25rem;height:2.25rem;flex-shrink:0;border:0;border-radius:50%;background:var(--accent, #1f6fd6);color:var(--accent-ink, #ffffff);cursor:pointer}.ds-send:hover{filter:brightness(1.08)}.ds-send:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-send svg{width:1.15rem;height:1.15rem;fill:none;stroke:currentColor;stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Stopp-Knopf",
      "kind": "button",
      "refersTo": "button-stop",
      "description": "Ersetzt Senden an derselben Stelle, solange ein Turn läuft.",
      "html": "<button class=\"ds-stop\" aria-label=\"Stopp\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><rect x=\"7\" y=\"7\" width=\"10\" height=\"10\" rx=\"1.5\"/></svg></button>",
      "css": ".ds-stop{display:grid;place-items:center;width:2.25rem;height:2.25rem;border:0;border-radius:50%;background:var(--ink, #1a1c20);color:var(--bg, #ffffff);cursor:pointer}.ds-stop:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-stop svg{width:1.15rem;height:1.15rem;fill:currentColor}"
    },
    {
      "name": "Neues Gespräch",
      "kind": "button",
      "refersTo": "button-new-chat",
      "description": "Umrandeter Knopf oben in der Seitenleiste.",
      "html": "<button class=\"ds-new-chat\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 20h9\"/><path d=\"M16.5 3.5a2.1 2.1 0 013 3L7 19l-4 1 1-4z\"/></svg><span>Neues Gespräch</span></button>",
      "css": ".ds-new-chat{display:flex;align-items:center;gap:0.6rem;width:16rem;padding:0.6rem 0.65rem;border:1px solid var(--line, #e4e6ea);border-radius:0.65rem;background:var(--raised, #ffffff);color:var(--ink, #1a1c20);font:500 0.9375rem/1.5 system-ui,sans-serif;cursor:pointer}.ds-new-chat:hover{background:var(--hover, #eceef1)}.ds-new-chat:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-new-chat svg{width:1.1rem;height:1.1rem;fill:none;stroke:var(--muted, #5c626c);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}"
    },
    {
      "name": "Gesprächsliste",
      "kind": "nav",
      "refersTo": "conversation-item",
      "description": "Einträge der Seitenleiste mit Agentenpunkt, aktuelles Gespräch hervorgehoben.",
      "html": "<nav class=\"ds-nav\"><p class=\"ds-group\">Web-Gespräche</p><button class=\"ds-conv\" aria-current=\"true\"><span class=\"ds-conv-title\">Wie betreibe ich tybo am besten?</span><span class=\"ds-conv-meta\"><span class=\"ds-dot\" style=\"--agent:#cf6a2e\"></span>General</span></button><button class=\"ds-conv\"><span class=\"ds-conv-title\">Was kostet ein kleiner VPS?</span><span class=\"ds-conv-meta\"><span class=\"ds-dot\" style=\"--agent:#0f8b7f\"></span>Research</span></button></nav>",
      "css": ".ds-nav{width:16rem;padding:0.75rem;background:var(--sidebar, #f5f6f8);display:grid;gap:1px}.ds-group{margin:0 0.5rem 0.35rem;color:var(--muted, #5c626c);font:600 0.75rem/1.5 system-ui,sans-serif}.ds-conv{display:grid;gap:0.1rem;width:100%;padding:0.5rem 0.6rem;border:0;border-radius:0.55rem;background:none;text-align:left;color:var(--ink, #1a1c20);font:0.9375rem/1.5 system-ui,sans-serif;cursor:pointer}.ds-conv:hover{background:var(--hover, #eceef1)}.ds-conv[aria-current=\"true\"]{background:var(--active, #e2e9f5)}.ds-conv:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-conv-title{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.ds-conv-meta{display:flex;align-items:center;gap:0.4rem;color:var(--muted, #5c626c);font-size:0.75rem}.ds-dot{width:0.5rem;height:0.5rem;border-radius:50%;background:var(--agent)}"
    },
    {
      "name": "Agent-Chip",
      "kind": "chip",
      "refersTo": "agent-chip",
      "description": "Pille in der Kopfzeile, zeigt den Agenten des Gesprächs.",
      "html": "<span class=\"ds-agent-chip\" style=\"--agent:#0f8b7f\">Research</span>",
      "css": ".ds-agent-chip{display:inline-flex;align-items:center;gap:0.4rem;padding:0.15rem 0.6rem 0.15rem 0.5rem;border-radius:999px;background:var(--hover, #eceef1);color:var(--muted, #5c626c);font:500 0.8125rem/1.5 system-ui,sans-serif}.ds-agent-chip::before{content:\"\";width:0.5rem;height:0.5rem;border-radius:50%;background:var(--agent)}"
    },
    {
      "name": "Nachrichtenpaar",
      "kind": "card",
      "refersTo": "bubble-user",
      "description": "Nutzerblase rechts, Antwort ohne Blase mit Agentenkopf.",
      "html": "<div class=\"ds-msgs\"><div class=\"ds-user\"><div>Wie wird das Wetter morgen?</div></div><article class=\"ds-answer\"><div class=\"ds-head\" style=\"--agent:#cf6a2e\"><span class=\"ds-dot2\"></span>General</div><p>Morgen bleibt es trocken, am Nachmittag bis 18 Grad.</p></article></div>",
      "css": ".ds-msgs{display:flex;flex-direction:column;gap:1.75rem;max-width:47.5rem;font:1rem/1.5 system-ui,sans-serif;color:var(--ink, #1a1c20)}.ds-user{display:flex;justify-content:flex-end}.ds-user>div{max-width:min(85%,36rem);padding:0.6rem 0.95rem;border-radius:1.15rem 1.15rem 0.35rem 1.15rem;background:var(--bubble, #e8effb);color:var(--bubble-ink, #14233a)}.ds-answer p{margin:0;line-height:1.65}.ds-head{display:flex;align-items:center;gap:0.45rem;margin-bottom:0.4rem;color:var(--muted, #5c626c);font-size:0.8125rem;font-weight:600}.ds-dot2{width:0.5rem;height:0.5rem;border-radius:50%;background:var(--agent)}"
    },
    {
      "name": "Statuszeile",
      "kind": "custom",
      "refersTo": "activity-line",
      "description": "Einklappbare Pille für einen laufenden Turn mit Fortschrittsliste.",
      "html": "<div><button class=\"ds-activity\" aria-expanded=\"true\"><span class=\"ds-adot\"></span><span>Datei lesen …</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 9l6 6 6-6\"/></svg></button><ul class=\"ds-progress\"><li>Datei lesen</li><li><em>Ich denke über die Frage nach</em></li><li class=\"ds-notice\">Hinweis: Das dauert etwas länger.</li></ul></div>",
      "css": ".ds-activity{display:inline-flex;align-items:center;gap:0.55rem;padding:0.35rem 0.7rem 0.35rem 0.6rem;border:1px solid var(--line, #e4e6ea);border-radius:999px;background:none;color:var(--muted, #5c626c);font:0.875rem/1.5 system-ui,sans-serif;cursor:pointer}.ds-activity:hover{background:var(--hover, #eceef1);color:var(--ink, #1a1c20)}.ds-activity:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:2px}.ds-adot{width:0.5rem;height:0.5rem;border-radius:50%;background:var(--accent, #1f6fd6)}.ds-activity svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-activity[aria-expanded=\"true\"] svg{transform:rotate(180deg)}.ds-progress{margin:0.6rem 0 0 0.85rem;padding:0 0 0 0.9rem;border-left:1px solid var(--line, #e4e6ea);list-style:none;color:var(--muted, #5c626c);font:0.875rem/1.5 system-ui,sans-serif}.ds-progress li{padding:0.2rem 0}.ds-notice{margin:0.35rem 0;padding:0.45rem 0.7rem!important;border-radius:0.6rem;background:var(--hover, #eceef1);color:var(--ink, #1a1c20)}"
    },
    {
      "name": "Passwortfeld",
      "kind": "input",
      "refersTo": "input-text",
      "description": "Textfeld des Logins, Vorlage für Felder in M3.",
      "html": "<label class=\"ds-field\"><span>Passwort</span><input type=\"password\" value=\"geheim\"></label>",
      "css": ".ds-field{display:grid;gap:0.6rem;width:21rem;font:600 0.875rem/1.5 system-ui,sans-serif;color:var(--ink, #1a1c20)}.ds-field input{padding:0.75rem 0.9rem;border:1px solid var(--line, #e4e6ea);border-radius:0.75rem;background:var(--raised, #ffffff);color:inherit;font:400 1rem/1.5 system-ui,sans-serif}.ds-field input:focus-visible{outline:2px solid var(--accent, #1f6fd6);outline-offset:1px}"
    }
  ],
  "narrative": {
    "northStar": "Der vertraute Schreibtisch",
    "overview": "Die WebUI sieht absichtlich aus wie ein Werkzeug, das man schon kennt: links die Gesprächsliste wie in Telegram Desktop, rechts der Chat wie in ChatGPT. Das System verweigert eine eigene Effekt-Welt. Es besteht aus neutralem Grau, einer einzigen ruhigen blauen Akzentfarbe, der Systemschrift des Geräts, feinen 1-px-Linien und einer runden Eingabebox. Der Dunkelmodus ist ein gleichwertiges Anthrazit, kein invertiertes Hell; beide Modi folgen allein `prefers-color-scheme`, es gibt keinen Umschalter.\n\nCharakter trägt nur, was Information trägt: die Agentenfarben (ein Punkt pro Agent), die einklappbare Statuszeile eines laufenden Turns und kleine Details wie der Senden-Knopf, der zum Stopp wird. Die Dichte ist die eines Chat-Werkzeugs, nicht die einer Landingpage: 16 px Grundschrift, eine Lesespalte von 760 px, großzügige 1.75rem Abstand zwischen Nachrichten, sonst kompakt.\n\nBewegung gibt es genau zweimal: Nachrichten blenden ein, die Schublade gleitet. Alles andere (Chevron, Hover, Senden/Stopp) wechselt sofort ohne Übergang. Unter `prefers-reduced-motion: reduce` entfallen auch die beiden Bewegungen.",
