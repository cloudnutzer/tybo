# ============================================================
# tybo - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Deployment modes:
#   LOCAL ONLY   — Run on your desktop with Claude Code CLI (uses your subscription)
#   VPS ONLY     — Run on a cloud server with Anthropic API (pay-per-token)
#   HYBRID       — VPS always on, forwards to local when awake (recommended)
# ============================================================

# --- REQUIRED ---

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_USER_ID=your_telegram_user_id

# Your name (used in prompts and voice calls)
USER_NAME=Your Name

# Bot name (the name your bot uses for itself)
BOT_NAME=Go

# Your timezone (IANA format: America/New_York, Europe/Berlin, etc.)
USER_TIMEZONE=UTC

# Claude Code CLI path (usually auto-detected, local mode only)
# CLAUDE_PATH=claude

# --- DATABASE: Choose ONE (Convex or Supabase) ---
# tybo works with either backend. Pick one during Phase 2 setup.
# If both are set, Convex takes priority.

# Option A: Convex (recommended — one command setup)
# CONVEX_URL=https://your-deployment.convex.cloud

# Option B: Supabase (full SQL access, self-hostable)
# SUPABASE_URL=https://your-project.supabase.co
# Beide Schlüsselarten gehen (Dashboard: Project Settings, API Keys):
# SUPABASE_SERVICE_ROLE_KEY nimmt den Secret key (sb_secret_…) oder bei
# älteren Projekten service_role, SUPABASE_ANON_KEY den Publishable key
# (sb_publishable_…) oder anon. Der Bot schreibt mit SUPABASE_SERVICE_ROLE_KEY.
# SUPABASE_ANON_KEY=your_publishable_or_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_secret_or_service_role_key
# Storage bucket for images and files (private). Default: tybo-assets.
# Bestehende Installationen mit anderem Ordnernamen tragen ihn hier ein.
# SUPABASE_ASSETS_BUCKET=tybo-assets

# --- VPS MODE ---
# Required when running the VPS gateway (bun run vps)
# Uses Anthropic Messages API directly — no Claude Code subprocess needed.
# Cost: ~$3/1M input tokens, ~$15/1M output tokens (Sonnet)

# Anthropic API key (get from console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# Model to use (default: claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- AGENT SDK (VPS) ---
# Enables full Claude Code capabilities on VPS for Sonnet/Opus requests.
# When false or missing, all VPS requests use direct Anthropic API.
# Haiku requests always use direct API regardless of this setting.
# USE_AGENT_SDK=true

# Daily API budget (USD) — auto-downgrades Opus to Sonnet when running low.
# Only relevant when using the Anthropic API (VPS mode).
#
# Budget guidance:
#   $5   — Minimum viable. Opus requests will downgrade to Sonnet quickly.
#   $15  — Recommended for moderate use (5-10 Opus conversations/day).
#   $50+ — Heavy use with frequent Opus/research tasks.
#
# A single complex Opus conversation can cost $3-5. If budget feels tight,
# increase this value — the bot will use cheaper models when budget runs low.
# DAILY_API_BUDGET=15.00

# --- CLAUDE SUBSCRIPTION CREDIT GUARD (Local/Hybrid mode) ---
# From 2026-06-15, Anthropic meters programmatic `claude -p` / Agent SDK usage that
# runs on a Claude Pro/Max SUBSCRIPTION (i.e. no ANTHROPIC_API_KEY set) against a
# fixed monthly "Agent SDK credit": Pro $20 / Max 5x $100 / Max 20x $200 (no rollover).
# Past it, usage overflows at API rates (if you enabled usage-credits) or stops.
# If you run with your own ANTHROPIC_API_KEY you are EXEMPT — pay-as-you-go, unchanged.
#
# tybo's credit guard (ON by default) routes each message to the cheapest model that
# fits so your credit lasts ~3-5x longer, self-meters your spend (see /credit), warns
# at 80%, and at 100% drops to a cheaper model so your bot keeps working. It also LEARNS
# your real ceiling the first time you hit the limit — so if you change Claude plans,
# it adjusts on its own. Everything is fail-open: if anything's off, your bot is unaffected.
#
# CREDIT_GUARD=off            # disable entirely (not recommended on a subscription)
# CREDIT_CEILING_USD=200      # your plan's monthly credit (Pro 20 / Max5x 100 / Max20x 200).
                              # If unset, tybo won't pre-warn but still meters + learns it.
# CREDIT_RESET_DAY=1          # day-of-month your Claude billing cycle resets (1-28)
# CREDIT_MODE=lowcost         # at 100%: "lowcost" = drop to a cheaper model (stay on sub);
                              #          "overflow" = keep full power, pay API overage
# CREDIT_CAP_TIER=sonnet      # the model to cap to in lowcost mode (sonnet | haiku)
# CREDIT_WARN_PCT=0.8         # warn once per cycle at this fraction of the ceiling

# --- HYBRID MODE ---
# When VPS detects your local machine is online, it forwards messages there.
# Local machine processes with Claude Code CLI (uses your subscription authentication).

# URL for local machine's health check (via Cloudflare Tunnel, ngrok, etc.)
# MAC_HEALTH_URL=https://your-tunnel.example.com/health

# URL for local machine's message processing endpoint
# MAC_PROCESS_URL=https://your-tunnel.example.com/process

# Shared secret between VPS and local machine
# GATEWAY_SECRET=your_shared_secret

# Node identifier (default: "vps" on server, "local" on desktop)
# NODE_ID=vps

# --- AUTO-DEPLOY (VPS) ---
# GitHub webhook secret for automatic deployment on push
# DEPLOY_SECRET=your_github_webhook_secret
# DEPLOY_BRANCH=refs/heads/master
# DEPLOY_SCRIPT=deploy.sh

# --- OPTIONAL: Morning Briefing Data Sources ---
# Sources auto-enable when their env vars are set.
# Run: bun run setup/setup-google-oauth.ts to get Google tokens.

# AI News (xAI Grok API)
# XAI_API_KEY=your_xai_key

# Google Services (Gmail + Calendar)
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token

# Notion Tasks
# NOTION_TOKEN=your_notion_integration_token
# NOTION_DATABASE_ID=your_tasks_database_id

# --- OPTIONAL: Board Meeting Data Sources ---
# These power the /board command with live data per agent.
# All optional — board meetings work without them, just less informed.

# Notion databases for board meeting context
# NOTION_CONTENT_PIPELINE_DB=your_content_pipeline_database_id
# NOTION_TRANSACTIONS_DB=your_transactions_database_id

# GitHub token (for private repositories, e.g. MCP servers or your own scripts)
# GITHUB_TOKEN=your_github_pat

# --- OPTIONAL: Semantic Search (Embeddings) ---
# Gemini is FREE and used for embeddings automatically when GEMINI_API_KEY is set.
# OpenAI is a fallback if Gemini key is not available.
# Without either, the bot uses basic text search instead of semantic search.

# OPENAI_API_KEY=sk-your-openai-key-here  # Fallback for embeddings + asset descriptions

# --- OPTIONAL: Fallback LLMs (local mode) ---
# When Claude Code auth fails, these provide backup responses

# OpenRouter (cloud fallback - recommended)
# Get a key at https://openrouter.ai — pay-per-use, many models available.
# OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODEL=minimax/minimax-m2.7

# Ollama (local offline fallback, Tier 2 after OpenRouter)
# OLLAMA_MODEL=qwen3:8b

# Set to true to skip OpenRouter and only use Ollama (fully offline mode)
# FALLBACK_OFFLINE_ONLY=true

# --- OPTIONAL: Voice & Transcription ---
# Gemini handles BOTH transcription (speech-to-text) AND voice replies (text-to-speech).
# Same API key, both free via Gemini 2.5 Flash free tier.

# GEMINI_API_KEY=your_gemini_key
# GEMINI_TTS_VOICE=Kore
# Available voices: Zephyr (bright), Puck (upbeat), Charon (informative), Kore (firm),
#   Fenrir (excitable), Leda (youthful), Aoede (breezy), Orus (firm), and 22 more.
#   Full list: https://ai.google.dev/gemini-api/docs/speech-generation

# --- OPTIONAL: Phone Calls ---
# ElevenLabs Conversational AI + Twilio for outbound AI phone calls

# ELEVENLABS_API_KEY=your_key
# ELEVENLABS_AGENT_ID=your_agent_id
# ELEVENLABS_PHONE_NUMBER_ID=your_phone_number_id
# USER_PHONE_NUMBER=+1234567890
# Name des Sprachagenten in der Begrüßung am Telefon und in der Sprach-Brücke
# (src/voice-bridge.ts). Leer oder nicht gesetzt: der Produktname (tybo).
# VOICE_AGENT_NAME=Mia

# --- MULTI-BOT AGENT IDENTITY (Optional) ---
# Create separate bots via @BotFather for visible agent identities.
# Each agent posts from its own bot in forum topics and board meetings.
# If not set, all responses come from the primary bot (backward compatible).
# TELEGRAM_BOT_TOKEN_RESEARCH=
# TELEGRAM_BOT_TOKEN_CONTENT=
# TELEGRAM_BOT_TOKEN_FINANCE=
# TELEGRAM_BOT_TOKEN_STRATEGY=
# TELEGRAM_BOT_TOKEN_CRITIC=
# TELEGRAM_BOT_TOKEN_CTO=
# TELEGRAM_BOT_TOKEN_COO=

# --- OPTIONAL: WhatsApp Gateway (Twilio) ---
# Receive and respond to WhatsApp messages via Twilio.
# Run: bun run whatsapp

# Twilio credentials (from console.twilio.com)
# TWILIO_ACCOUNT_SID=your_account_sid
# TWILIO_AUTH_TOKEN=your_auth_token

# Your WhatsApp number (messages from other numbers are ignored)
# WHATSAPP_USER_NUMBER=+49XXXXXXXXXXX

# Your Twilio WhatsApp-enabled number (if you have one)
# TWILIO_WHATSAPP_NUMBER=+1XXXXXXXXXX

# Twilio sandbox number (default: +14155238886, used if TWILIO_WHATSAPP_NUMBER is not set)
# TWILIO_SANDBOX_NUMBER=+14155238886

# WhatsApp gateway port (default: 3001)
# PORT_WHATSAPP=3001

# The public URL of your webhook (needed for Twilio signature validation behind proxies/tunnels)
# WHATSAPP_WEBHOOK_URL=https://your-domain.com/webhook/whatsapp

# --- SUPABASE CLI ---
# Access token for Supabase CLI commands (link, secrets, edge functions)
# Get from: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=your_supabase_access_token

# --- SYSTEM ---
# HTTP server port (default: 3000)
# PORT=3000

# Updated February 19, 2026: Clarified deployment modes and authentication following Anthropic's January 2026 ToS enforcement.

# --- Per-topic Claude sessions (optional, docs/topic-sessions.md) ---
# SESSION_MODE=resume keeps one Claude CLI session per Telegram topic/DM and
# continues it with --resume: follow-up messages send only a slim prompt
# (time + semantic hits + message) instead of rebuilding the full context.
# Cuts token usage massively on long conversations. Leave unset to disable.
# SESSION_MODE=resume
# Hours of inactivity after which a topic session starts fresh (default 18):
# SESSION_IDLE_HOURS=18

# --- Claude-Subprozesse (Issue #54) ---
# Claude-Subprozesse erben keine Geheimnisse (*_TOKEN, *_KEY, *_SECRET,
# *PASSWORD*, *_PASS, SUPABASE_*, TELEGRAM_*). Ausnahmen: ANTHROPIC_API_KEY,
# in MCP-Konfigurationen referenzierte Variablen und diese Freigabeliste
# (kommagetrennte Namen). Siehe docs/troubleshooting.md
# TYBO_SUBPROCESS_ENV_ALLOW=GH_TOKEN,CLOUDFLARE_API_TOKEN
# Eigenes launchd-Label des Bots für restart:request (sonst ai.tybo.telegram-relay)
# TYBO_LAUNCHD_LABEL=ai.tybo.telegram-relay

# --- TOOL-ZUGAENGE (Source of Truth fuer alle externen Tool-Keys: src/lib/credentials.ts) ---
# Diese Keys machen Firecrawl, Apify und Cloudflare auch im Fallback-Pfad
# (OpenRouter/Kimi K3/Ollama) nutzbar. .env ist die Source of Truth; die
# Credential Registry (src/lib/credentials.ts) kann als Migrations-Fallback
# noch aus ~/.claude.json aufloesen.

# Firecrawl API key (Scraping/Crawling/Search). Get from: https://firecrawl.dev
# FIRECRAWL_API_KEY=fc-...

# Apify API key (Actor-Runs, z.B. LinkedIn-Scraper). Get from: https://console.apify.com
# APIFY_API_KEY=apify_api_...

# Cloudflare account-scoped API token + Account ID (wrangler Pages/Workers Deploys).
# ACHTUNG: cfat_-Tokens sind account-owned, nur account-scoped verifizierbar.
# CLOUDFLARE_API_TOKEN=cfat_...
# CLOUDFLARE_ACCOUNT_ID=...

# --- Autonome Features ---
# Aux-Modell-Routing: Nebenaufgaben laufen auf eigenen Modellen. Format
# "<kind>:<model>" mit kind = claude | openrouter | ollama.
# Defaults: Judge = claude:claude-opus-5 (Urteilsarbeit, mindestens Opus,
# effort high), Destillat/Review = claude:claude-haiku-4-5-20251001 (Extraktion).
# AUX_MODEL_JUDGE=claude:claude-opus-5
# AUX_MODEL_DISTILL=claude:claude-haiku-4-5-20251001
# AUX_MODEL_REVIEW=openrouter:minimax/minimax-m2.7

# /goal Turn-Budget: nach so vielen autonomen Arbeits-Turns pausiert das Ziel
# und fragt per Button nach (Default 10):
# GOAL_MAX_TURNS=10

# Cross-Agent Reply-Budget: max. [INVOKE:]-Konsultationen pro Antwort (Default 3):
# AGENT_INVOKE_BUDGET=3

# Session-Destillat direkt schreiben statt per Buttons vorzuschlagen (Legacy):
# DISTILL_AUTO_APPLY=true

# Security hardening (2026-09-09): optional integrations fail closed.
# One shared random secret for local /process, VPS and voice deep-thinking.
# GATEWAY_SECRET=<openssl rand -hex 32>
# HEALTH_HOST=127.0.0.1
# GATEWAY_ALLOWED_CHAT_IDS=-1001234567890
# WHATSAPP_OWNER_NUMBER=+491234567890
# WHATSAPP_HOST=127.0.0.1
# VOICE_BRIDGE_HOST=127.0.0.1
# ELEVENLABS_WEBHOOK_SECRET=<secret from ElevenLabs webhook settings>
# /context callers send Authorization: Bearer <GATEWAY_SECRET>.
# Server DB access requires SUPABASE_SERVICE_ROLE_KEY; anon keys are insufficient.
# Convex deployments require a verified OIDC service identity (configure on Convex too):
# CONVEX_AUTH_ISSUER=https://issuer.example
# CONVEX_AUTH_AUDIENCE=tybo
# CONVEX_OWNER_TOKEN_IDENTIFIER=https://issuer.example|service-subject
# CONVEX_AUTH_TOKEN=<service JWT; refresh before expiry>
# MAX_AGENT_PROCESSES=3
# Only explicitly audited MCP read tools may skip interactive approval:
# MCP_READ_ONLY_TOOLS=server/exact_read_tool_name
# Durable daily API ledger (UTC); unknown charges retain their reservation.
# DAILY_API_BUDGET=5
# FALLBACK_REQUEST_RESERVATION_USD=1
# VOICE_REQUEST_RESERVATION_USD=1
# GUEST_REQUEST_RESERVATION_USD=0.25

# --- WebUI (docs/webui/SPEC.md) ---
# Browser-Chat im Bot-Prozess. Startet nur mit WEB_ENABLED=true und einem
# Passwort mit mindestens 12 Zeichen, auch auf localhost.
# WEB_ENABLED=false
# WEB_PASSWORD=<openssl rand -base64 18>
# Standard ist nur dieser Rechner. Fuers Heimnetz WEB_HOST=0.0.0.0 oder die LAN-IP.
# Sicherheit: Im Heimnetz laeuft die WebUI ueber unverschluesseltes HTTP; wer im
# selben WLAN mitschneidet, sieht Passwort und Chat.
# WEB_HOST=127.0.0.1
# WEB_PORT=3100
# Zusaetzliche Host-Namen, unter denen die WebUI aufgerufen wird (Komma-Liste,
# ohne Port). localhost, 127.0.0.1, [::1] und die IPs des Rechners gelten immer.
# WEB_ALLOWED_HOSTS=mein-mac.local
# Oeffentliche Adresse hinter dem Cloudflare Tunnel (Entscheidung 0014), nur
# https ohne Port und Pfad. Getunnelte Anfragen (von 127.0.0.1 mit
# CF-Connecting-IP) muessen genau diesen Host und Origin haben und einen
# gueltigen Cloudflare-Access-Nachweis tragen. Anleitung: docs/webui/fernzugang.md
# WEB_PUBLIC_ORIGIN=https://app.tybo.ai
# Cloudflare Access: Team-Name (meinteam fuer meinteam.cloudflareaccess.com)
# und Application Audience (AUD) Tag, nur beide zusammen. Ohne sie lehnt die
# WebUI bei gesetztem WEB_PUBLIC_ORIGIN jede getunnelte Anfrage ab.
# WEB_ACCESS_TEAM=meinteam
# WEB_ACCESS_AUD=
# Schluessel in der WebUI setzen und loeschen (Seite "Schluessel"). Ohne diese
# Zeile ist die Seite schreibgeschuetzt. WEB_*, TELEGRAM_BOT_TOKEN und
# TELEGRAM_USER_ID bleiben immer Handarbeit in dieser Datei. Vor jeder
# Aenderung legt die WebUI eine Sicherung in data/backups/ an.
# WEB_ALLOW_KEY_EDIT=true
