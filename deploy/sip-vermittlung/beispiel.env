# Beispiel-.env der SIP-Vermittlung (Issue #511). Auf dem Server als .env
# neben compose.yaml ablegen (chmod 600) und die Werte ersetzen. Alle Werte
# hier sind erfunden; die Prüfung (bun run deploy/sip-vermittlung/pruefen.ts)
# erzeugt die Konfiguration aus genau dieser Datei.

# --- easybell: SIP-Zugang des Anschlusses (Kundenportal, Telefonie) ---
EASYBELL_BENUTZER=beispiel-benutzer
EASYBELL_PASSWORT=Beispiel-Passwort-123
# Die Rufnummer des Anschlusses in E.164, genau so wie sie bei ElevenLabs als
# SIP-Trunk-Nummer angelegt ist
EASYBELL_RUFNUMMER=+4930123456789
# tls (Standard, mit SRTP) oder udp
EASYBELL_TRANSPORT=tls
# Format der gewählten Nummer: e164 (+49…), 00 (0049…) oder national (0151…)
EASYBELL_WAHLFORMAT=e164
# EASYBELL_REGISTRAR=voip.easybell.de

# --- ElevenLabs ---
# Ziel für eingehende Anrufe (Standard: sip.rtc.elevenlabs.io, TLS auf 5061)
# ELEVENLABS_SIP_ZIEL=sip.rtc.elevenlabs.io
# Anmeldung der Vermittlung bei ElevenLabs: dieselben Werte stehen bei der
# Nummer unter "Inbound Configuration", Digest-Anmeldung
ELEVENLABS_EIN_BENUTZER=vermittlung-hin
ELEVENLABS_EIN_PASSWORT=Beispiel-Hin-Passwort-123
# Anmeldung von ElevenLabs bei der Vermittlung (/anruf): dieselben Werte
# stehen bei der Nummer unter "Outbound Configuration"; mindestens 16 Zeichen
ELEVENLABS_AUS_BENUTZER=vermittlung-her
ELEVENLABS_AUS_PASSWORT=Beispiel-Her-Passwort-1234567890

# --- Vermittlung ---
# Rechnername mit gültigem Zertifikat (zertifikat/fullchain.pem, privkey.pem)
SIP_HOSTNAME=sip.example.org
SIP_TLS_PORT=5061
# RTP-Bereich: mindestens 4 Ports je Gespräch
RTP_START=10000
RTP_ENDE=10019
# Positivliste für ausgehende Anrufe, kommagetrennt in E.164. Ohne Wert gilt
# nur USER_PHONE_NUMBER.
# ERLAUBTE_ZIELE=
USER_PHONE_NUMBER=+4915550100123
# Höchstens 2 Gespräche gleichzeitig, über beide Richtungen
MAX_GESPRAECHE=2
# Höchstdauer je Gespräch in Minuten (1 bis 60)
MAX_MINUTEN=10
# Eingehende Anrufe mit unterdrückter Nummer: ablehnen (Standard) oder annehmen
UNTERDRUECKTE_NUMMER=ablehnen
